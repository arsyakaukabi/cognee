# Kuzu source (absolute path to Kuzu database directory)
KUZU_DB_PATH=/absolute/path/to/cognee/.cognee_system/databases/cognee_graph_kuzu

# Neo4j target (Bolt connection)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please_change
# Optional: set if using multi-database
NEO4J_DATABASE=neo4j

# Migration output
MIGRATION_OUTPUT_DIR=/absolute/path/to/cognee/graph-migration/output
NEO4J_BATCH_SIZE=10000

# Safety flags
NEO4J_ALLOW_NONEMPTY=false
NEO4J_CLEAR_DATABASE=false
MIGRATION_CLEAN_OUTPUT=false

# Optional overrides for raw CSV locations
# KUZU_NODES_CSV=/path/to/nodes.csv
# KUZU_EDGES_CSV=/path/to/edges.csv
